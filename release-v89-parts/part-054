62D\u062F\u062B \u0641\u064A \u0647\u0630\u0647 \u0627\u0644\u0642\u0646\u0648\u0627\u062A \u0627\u0644\u0635\u0648\u062A\u064A\u0629. \u0625\u0630\u0627 \u0639\u064F\u0637\u0644\u062A \u0647\u0630\u0647 \u0627\u0644\u0635\u0644\u0627\u062D\u064A\u0629\u060C \u064A\u0643\u0648\u0646 \u0627\u0644\u0623\u0639\u0636\u0627\u0621 \u0639\u0644\u0649 \u0627\u0644\u0645\u064A\u0648\u062A \u0627\u0641\u062A\u0631\u0627\u0636\u064A\u0627\u064B \u062D\u062A\u0649 \u064A\u0641\u0643 \u0627\u0644\u0645\u064A\u0648\u062A \u0634\u062E\u0635 \u0644\u062F\u064A\u0647 \u0635\u0644\u0627\u062D\u064A\u0629 "\u0645\u064A\u0648\u062A \u0627\u0644\u0623\u0639\u0636\u0627\u0621".','Allows members to talk in this voice channel. If this permission is disabled, members are default muted until somebody with the "Mute Members" permission un-mutes them.':'\u064A\u0633\u0645\u062D \u0644\u0644\u0623\u0639\u0636\u0627\u0621 \u0628\u0627\u0644\u062A\u062D\u062F\u062B \u0641\u064A \u0647\u0630\u0647 \u0627\u0644\u0642\u0646\u0627\u0629 \u0627\u0644\u0635\u0648\u062A\u064A\u0629. \u0625\u0630\u0627 \u0639\u064F\u0637\u0644\u062A \u0647\u0630\u0647 \u0627\u0644\u0635\u0644\u0627\u062D\u064A\u0629\u060C \u064A\u0643\u0648\u0646 \u0627\u0644\u0623\u0639\u0636\u0627\u0621 \u0639\u0644\u0649 \u0627\u0644\u0645\u064A\u0648\u062A \u0627\u0641\u062A\u0631\u0627\u0636\u064A\u0627\u064B \u062D\u062A\u0649 \u064A\u0641\u0643 \u0627\u0644\u0645\u064A\u0648\u062A \u0634\u062E\u0635 \u0644\u062F\u064A\u0647 \u0635\u0644\u0627\u062D\u064A\u0629 "\u0645\u064A\u0648\u062A \u0627\u0644\u0623\u0639\u0636\u0627\u0621".',"Allows members to upload files or media in text channels.":"\u064A\u0633\u0645\u062D \u0644\u0644\u0623\u0639\u0636\u0627\u0621 \u0628\u0631\u0641\u0639 \u0627\u0644\u0645\u0644\u0641\u0627\u062A \u0623\u0648 \u0627\u0644\u0648\u0633\u0627\u0626\u0637 \u0641\u064A \u0627\u0644\u0642\u0646\u0648\u0627\u062A \u0627\u0644\u0646\u0635\u064A\u0629.","Allows members to upload files or media in these channels.