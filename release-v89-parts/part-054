5\u0646 \u0637\u0631\u0641 \u062B\u0627\u0644\u062B. \u0625\u0630\u0627 \u0623\u0644\u063A\u064A\u062A \u0627\u0644\u0627\u0634\u062A\u0631\u0627\u0643\u060C \u0645\u0645\u0643\u0646 \u0645\u0627 \u0632\u0627\u0644 \u062A\u0634\u0648\u0641 \u0645\u0647\u0627\u0645\u060C \u0628\u0633 \u0645\u0627 \u0631\u0627\u062D \u062A\u0643\u0648\u0646 \u0645\u062E\u0635\u0635\u0629 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0628\u064A\u0627\u0646\u0627\u062A \u0645\u0646 \u0623\u0637\u0631\u0627\u0641 \u062B\u0627\u0644\u062B\u0629.","Allows Discord to personalize Sponsored Content, like Quests, using your Discord activity, such as the games you play. If you opt out you may still see Quests, but they won't be personalized.":"\u064A\u0633\u0645\u062D \u0644\u062F\u0633\u0643\u0648\u0631\u062F \u0628\u062A\u062E\u0635\u064A\u0635 \u0627\u0644\u0645\u062D\u062A\u0648\u0649 \u0627\u0644\u0645\u0645\u0648\u0644\u060C \u0645\u062B\u0644 \u0627\u0644\u0645\u0647\u0627\u0645 (\u0643\u0648\u064A\u0633\u062A\u0633)\u060C \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0646\u0634\u0627\u0637\u0643 \u0639\u0644\u0649 \u062F\u0633\u0643\u0648\u0631\u062F\u060C \u0645\u062B\u0644 \u0627\u0644\u0623\u0644\u0639\u0627\u0628 \u0627\u0644\u0644\u064A \u062A\u0644\u0639\u0628\u0647\u0627. \u0625\u0630\u0627 \u0623\u0644\u063A\u064A\u062A \u0627\u0644\u0627\u0634\u062A\u0631\u0627\u0643 \u0645\u0645\u0643\u0646 \u0645\u0627 \u0632\u0627\u0644 \u062A\u0634\u0648\u0641 \u0645\u0647\u0627\u0645\u060C \u0628\u0633 \u0645\u0627 \u0631\u0627\u062D \u062A\u0643\u0648\u0646 \u0645\u062E\u0635\u0635\u0629 \u0644\u0643.","Allows Discord to personalize Sponsored Content, like Quests, using your Discord activity.":"\u064A\u0633\u0645\u062D \u0644\u062F\u0633\u0643\u0648\u0631\u062F \u064A\u062E\u0635\u0651\u0635 \u0627\u0644\u0645\u062D\u062A\u0648\u0649 \u0627\u0644\u0645\u0645\u0648\u0651\u0644\u060C \u0645\u062B\u0644 \u0627\u0644\u0645\u0647\u0627\u0645\u060C \u062D\u0633\u0628 \u0646\u0634\u062