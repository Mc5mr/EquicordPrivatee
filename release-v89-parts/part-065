/* Fix to overwrite bad CSS in callTimer/alignedChatInputFix.css */
[class*="panels"] [class*="questProgressWrapper"] [class*="outer"] > [class*="inner"] {
    height: 100% !important;
}

/* Fix to overwrite bad CSS in callTimer/alignedChatInputFix.css */
[class*="panels"] [class*="questProgressWrapper"] > div {
    opacity: 1 !important;
}

/* Fix oversized confetti blocking Quest buttons. */
[class*="rewardDescriptionContainer"] [class*="progressWrapper"] > [class*="confetti"] {
    pointer-events: none;
}

/* Fix Questify button text clipping. */
.questify-quest-item-restyle button [class*="buttonChildren"],
.questify-quest-item-restyle button span {
    overflow: visible;
}

/* Prevent shifting in the progress subtitle. */
[class*="questProgressHint_"] {
    font-variant-numeric: tabular-nums;
}

/* Notices */

.questify-startup-notice-body {
    line-height: normal;
}

/* Quest tile preview */

.questify-dummy-quest-preview {
    cursor: default;
    margin-top: 12px;
    user-select: none;
}

.questify-dummy-quest {
    margin-top: 8px;
}

/* Background of Quest tile. */
.questify-quest-item-restyle > :where(div) {
    background-color: var(--questify-color) !important;
}

/* Normal button text + SVG button text color. */
.questify-quest-item-restyle > :nth-child(2) button > *,
.questify-quest-item-restyle > :nth-child(2) button > * > * > span {
    color: var(--questify-quest-name);
}

/* Watch again button SVG color. */
.questify-quest-item-restyle > :nth-child(2) button > div > div > svg path {
    fill: var(--questify-quest-name);
}

/* Allows glowing reward previews which aren't confined to their own square video frame to overflow. */
.questify-quest-item-restyle > div > div[class*="rewardDescriptionContainer"] {
    overflow: visible;
}

/* Quest name color. */
.questify-quest-item-restyle > div > div[class*="rewardDescriptionContainer"] > div[class*="textContainer"] > [class*="eyebrow"] {
    color: var(--questify-quest-name) !important;
}

/* Reward title + Orbs reward title text color. */
.questify-quest-item-restyle > div > div[class*="rewardDescriptionContainer"] > div[class*="textContainer"] > div[class*="text-md"],
.questify-quest-item-restyle > div > div[class*="rewardDescriptionContainer"] > div[class*="textContainer"] > div[class*="text-md"] > span {
    color: var(--questify-reward-title) !important;
}

/* Quest description text color. */
.questify-quest-item-restyle > div > div[class*="rewardDescriptionContainer"] > div[class*="textContainer"] > div[class*="text-sm"] {
    color: var(--questify-reward-description) !important;
}

.questify-quest-item-restyle [class*="placeholderElement"] {
    background-color: transparent;
}

/* Promoted by XYZ text color. */
.questify-quest-item-restyle > div[class*="container"] > div[class*="positionContentOverBackground"] > div[class*="contents"] > div[class*="bottomRow"] > div[class*="text-sm"] {
    color: var(--questify-reward-description) !important;
}

.questify-quest-item-contrast-logo > div[class*="container"] > div[class*="positionContentOverBackground"] > div[class*="contents"] > div[class*="partnerBranding"] > img {
    filter: drop-shadow(0 0 10px rgb(0 0 0 / 80%));
}

.questify-quest-item-intense-gradient > :nth-child(1) [class*="overlay"] {
    background: linear-gradient(to top,
            var(--questify-color) 0,
            hsl(from var(--questify-color) h s l / 100%) 20.5%,
            hsl(from var(--questify-color) h s l / 99.5%) 23.33%,
            hsl(from var(--questify-color) h s l / 98%) 26.66%,
            hsl(from var(--questify-color) h s l / 97%) 30%,
            hsl(from var(--questify-color) h s l / 90%) 40%,
            hsl(from var(--questify-color) h s l / 77%) 50%,
            hsl(from var(--questify-color) h s l / 0%) 100%);
}

.questify-quest-item-default-gradient > :nth-child(1) [class*="overlay"] {
    background: linear-gradient(to top,
            var(--questify-color) 0,
            hsl(from var(--questify-color) h s l / 95%) 20.31%,
            hsl(from var(--questify-color) h s l / 0%) 100%);
}

.questify-quest-item-black-gradient > :nth-child(1) [class*="overlay"] {
    background: linear-gradient(to top,
            hsl(0deg 0% 0% / 80%) 10%,
            hsl(0deg 0% 0% / 65%) 20%,
            hsl(0deg 0% 0% / 50%) 50%,
            hsl(0deg 0% 0% / 10%) 75%,
            hsl(0deg 0% 0% / 0%) 90%);
}

.questify-quest-item-hide-gradient > :nth-child(1) [class*="overlay"] {
    display: none;
}

.questify-quest-item-restyle > :nth-child(2) [class*="textOverflowBlur"] {
    background: linear-gradient(transparent 50%, var(--questify-color) 100%);
    filter: brightness(0.9);
}

.questify-quest-item-restyle > :nth-child(2) > div button {
    background-color: var(--questify-button-normal) !important;
}

.questify-quest-item-restyle > :nth-child(2) > div button:not([disabled]):hover {
    background-color: var(--questify-button-hover) !important;
    transition: background-color 0.2s ease-in-out;
}

.questify-quest-item-restyle > :nth-child(1) [class*="container"] {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

.questify-quest-item-restyle > :nth-child(2) [class*="container"] {
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

div[id^="quest-tile-"] div[class^="confetti__"] {
    pointer-events: none;
}

/* Quest Button */

#questify-dummy-quest-button {
    margin-right: -12px;
    margin-left: 5px;
    border-left: 5px solid var(--text-strong);
    border-radius: 4px;
}

.questify-quest-button-pill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    pointer-events: none;
}

.questify-quest-button-pill > [class*="item"] {
    will-change: transform;
    max-height: 8px;
    min-height: 8px;
    transition: max-height 0.2s ease-in-out;
}

.questify-quest-button-pill.hovered > [class*="item"] {
    max-height: 20px;
}

.questify-quest-button-pill.selected > [class*="item"] {
    max-height: 40px;
}

.questify-quest-button-server-list-button-container {
    position: relative;
}

.questify-quest-button-icon-container {
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}

.questify-quest-button-container {
    position: relative;
}`,classNames:{},dom:null});Dtt="src/plugins/questify/styles.css"});function Rhe(e){_e().isOnQuestsPage=e??window.location.pathname===vf}function ktt(e){let t=Date.now();Rhe(),Og(),Qtt(),Kpe(),hr.info(`START_TASKS-${e.toUpperCase()}`,{startedAt:t})}function Gtt(e,t=!0){let r=Date.now();Rhe(),BO(),Lhe.clear(),TO({manual:!1,preserveResume:t,terminalHeartbeat:!0}),hr.info(`STOP_TASKS-${e.toUpperCase()}`,{stoppedAt:r})}function Qtt(){The||!UY||(The=!0,Cet())}function Dar(e){let t=she({quest:e.quest});return t?n($,{noop:!0},n(Ear,{size:e.size,variant:"secondary",disabled:!1,fullWidth:!0,...t})):null}function Sar(e){return n("span",{style:{fontSize:"90%"}},e)}var Phe,The,Lhe,vE,Ear,tj,XO=m(()=>{"use strict";A();KA();K();hY();J();N();de();hhe();qet();ql();LY();Fg();Xet();i0();OO();Ett();FO();Stt();wO();yE();NY();gE();YY();Hx();kO();zg();uu();Phe=!1,The=!1,Lhe=new Set,vE=ln.plugins.Questify?.enabled;Ear=xe("BUTTON_LOADING_STARTED_LABEL)),");tj=b({name:"Questify",description:"Enhance specific Quest features, disable annoyances, or completely remove Quests.",authors:[q.Etorix],dependencies:["ServerListAPI"],startAt:"Init",managedStyle:Dtt,settings:Nhe,canOpenDevToolsWindow:xO,canAutoCompleteQuest:CE,disguiseHomeButton:Fet,enrolledIncompleteButton:Dar,formatLowerBadge:bO,getActiveAutoCompletes:c0,getLastFilterChoices:WVe,getLastSortChoice:ZVe,getQuestAutoCompleteProgress:set,getQuestEmbedProgress:Iet,getQuestButtonProps:she,getQuestPanelOverride:yet,getQuestPanelPercentComplete:ghe,getQuestPanelSubtitleText:Aet,getQuestTileClasses:DO,getQuestTileStyle:SO,getSettingsModalOpen:Qet,hasEnabledAutoCompleteQuestTypes:FY,normalizeQuestName:Np,openDevToolsWindow:Xpe,processQuestForAutoComplete:bE,rerenderQuests:_i,setHeartbeatStackTracePatchSucceeded:net,setLastFilterChoices:qVe,setLastSortChoice:HVe,setVideoProgressStackTracePatchSucceeded:oet,shouldForceQuestPanelVisible:xet,shouldPreloadQuestAssets:UVe,sortQuests:JVe,stopQuestAutoComplete:a0,useQuestRerender:zVe,wrapOrbsBalance:Sar